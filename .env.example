# Supabase-Projekt (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...   (Publishable Key)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   (Secret Key, nur serverseitig)

# Öffentliche URL der App (für Einladungs-Links)
NEXT_PUBLIC_APP_URL=https://protokolle.gumpoldskirchen.at

# Optional: SMTP für Benachrichtigungen an die Verwaltung (ohne Angaben werden keine Mails versendet)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sitzungsprotokolle Gumpoldskirchen <noreply@gumpoldskirchen.at>"
VERWALTUNG_EMAIL=gemeinde@gumpoldskirchen.at
